# ==============================================================================
# AI Expense Categorizer - Backend Environment Configuration Template
# Duplicate this file as .env and replace the placeholder values.
# ==============================================================================

# Database Configuration (MySQL)
# If using Railway or cloud connection string:
DATABASE_URL=mysql+pymysql://username:password@hostname:3306/database_name

# Or individual MySQL parameters (used if DATABASE_URL is not set):
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ai_expense_categorizer

# Application Environment: 'development' or 'production'
APP_ENV=development

# JWT Secret for Authentication (minimum 32 characters in production)
# Generate via: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=replace-with-a-random-secret-key-at-least-32-chars-long

# Google Gemini API Key (obtain from https://aistudio.google.com)
GEMINI_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# CORS Allowed Origins (comma-separated list of frontend URLs, without trailing slashes)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://your-frontend-name.onrender.com

# Cookie SameSite attribute: 'lax' for same-domain / localhost, 'none' for cross-domain
AUTH_COOKIE_SAMESITE=lax
